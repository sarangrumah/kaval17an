# ============================================================
#  JALUR MUDAH  — Apps Script  (disarankan)
#  Tidak perlu Google Cloud Console, tidak perlu service account.
# ============================================================
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfyc.../exec"
APPS_SCRIPT_KUNCI="hasil-dari-fungsi-buatKunciApi-di-apps-script"

# ============================================================
#  JALUR LANJUTAN — service account Google Cloud
#  Isi hanya bila APPS_SCRIPT_URL di atas DIKOSONGKAN.
# ============================================================
# GOOGLE_SERVICE_ACCOUNT_EMAIL="panitia@nama-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# SHEET_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890"

# ============================================================
#  LOGIN PANITIA
# ============================================================
ADMIN_USERNAME="bendahara"
# Buat dengan: npm run hash -- "passwordpilihananda"
ADMIN_PASSWORD_HASH="ganti-dengan-hasil-npm-run-hash"

# Kunci penanda tangan cookie sesi, minimal 32 karakter.
SESSION_SECRET="ganti-dengan-string-acak-panjang"
